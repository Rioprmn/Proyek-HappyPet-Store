/* Styling untuk Tabel di Admin */
.table-container {
    background: white;
    padding: 20px;
    border-radius: 12px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
}

.admin-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
}

.admin-table th {
    background-color: #f8fafc;
    color: #64748b;
    text-align: left;
    padding: 12px 15px;
    border-bottom: 2px solid #e2e8f0;
    font-size: 0.85rem;
    text-transform: uppercase;
}

.admin-table td {
    padding: 15px;
    border-bottom: 1px solid #f1f5f9;
    vertical-align: middle;
    color: #334155;
}

/* Badge Kategori */
.category-badge {
    background: #f0f9f8;
    color: #2c9a94;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
}

/* Tombol Aksi */
.btn-edit {
    color: #3b82f6;
    text-decoration: none;
    margin-right: 10px;
    font-size: 1.1rem;
}

.btn-delete {
    background: none;
    border: none;
    color: #ef4444;
    cursor: pointer;
    font-size: 1.1rem;
}

.btn-delete:hover, .btn-edit:hover {
    opacity: 0.7;
}